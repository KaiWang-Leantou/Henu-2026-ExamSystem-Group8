# ==========================================
# 1. 操作系统与 IDE 文件
# ==========================================
.DS_Store
Thumbs.db
.idea/
.vscode/

# ==========================================
# 2. 前端 (Vue3 + Vite + Node.js)
# ==========================================
node_modules/       # 忽略所有依赖包（体积巨大）
dist/               # 忽略 Vite 打包产物
.vite/              # 忽略 Vite 缓存
*.local             # 忽略本地环境配置

# ==========================================
# 3. 后端 (Java + Spring Boot)
# ==========================================
target/             # 忽略 Maven 编译输出目录
*.class             # 忽略 Java 字节码
*.jar               # 忽略打包的 Jar 文件（如果你不打算提交 Jar）
.mvn/wrapper/maven-wrapper.jar

# ==========================================
# 4. 敏感信息与 AI 配置 (防止泄露)
# ==========================================
.env
.env.*
!.env.example
.claude/
.cursor/
*.key
*.pem

# ==========================================
# 5. 日志与本地数据库
# ==========================================
*.log
logs/
# 如果开发环境用了 H2 文件库，忽略生成的本地文件
*.mv.db
*.trace.db