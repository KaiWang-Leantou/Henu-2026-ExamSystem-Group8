# ============================================================
# 换行符策略
# ------------------------------------------------------------
# *.bat / *.cmd 必须强制 CRLF：cmd.exe 解析批处理时按 CRLF 断行，
# 如果 checkout 出来是 LF，会出现 "'cho' 不是内部或外部命令" 这类
# 拆行错乱，脚本直接跑不起来。
# 这条规则与各人本机的 core.autocrlf 设置无关，clone 后一定是 CRLF。
# ============================================================
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 文本文件统一 LF，避免无意义的换行差异
*.md    text eol=lf
*.sql   text eol=lf
*.ini   text eol=lf
*.xml   text eol=lf
*.jsp   text eol=lf
*.java  text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf

# ============================================================
# 二进制文件（不做任何换行转换）
# ============================================================
*.jar   binary
*.war   binary
*.class binary
*.exe   binary
*.dll   binary
*.zip   binary

# MySQL 数据文件（正常情况下已被 .gitignore 忽略，这里再兜一层）
*.frm   binary
*.ibd   binary
*.MYD   binary
*.MYI   binary
*.CSM   binary
*.CSV   binary
*.sdi   binary
