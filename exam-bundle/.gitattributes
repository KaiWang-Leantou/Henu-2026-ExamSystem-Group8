# ============================================================
# 换行符与编码约定（很重要，改动前先读）
# ------------------------------------------------------------
# 【bat / cmd】必须是 GBK(cp936) 编码 + CRLF 换行。
#   原因：Windows 命令行默认代码页是 936，若 bat 文件本身是 UTF-8，
#         cmd 按 936 解析会把中文的多个字节拆错位置，出现
#         "…不是内部或外部命令"、"@echo off" 报错、脚本跳行等诡异问题。
#   因此 bat 文件里统一用 `chcp 936`，并保存为 GBK + CRLF。
#   注意：用 VS Code 打开 bat 显示乱码是正常的，右下角选 GBK(936) 即可查看。
#   千万不要用记事本"另存为 UTF-8"或改成 LF，会直接把脚本弄坏。
# ============================================================
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 文本文件统一 LF
*.md    text eol=lf
*.sql   text eol=lf
*.ini   text eol=lf
*.xml   text eol=lf
*.jsp   text eol=lf
*.java  text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf

# ============================================================
# 二进制文件（不做任何转换）
# ============================================================
*.jar   binary
*.war   binary
*.class binary
*.exe   binary
*.dll   binary
*.zip   binary

# MySQL 数据文件（正常情况下已被 .gitignore 忽略，这里再兜一层）
*.frm   binary
*.ibd   binary
*.MYD   binary
*.MYI   binary
*.CSM   binary
*.CSV   binary
*.sdi   binary
